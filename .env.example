PORT=3001
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=online_quiz
CORS_ORIGIN=http://localhost:5173
MAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key
RESEND_TEMPLATE_ID=your_published_daily_template_id
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="CodeSnipers <noreply@codesnipers.in>"
EMAIL_UNSUBSCRIBE_SECRET=replace_with_a_random_secret_of_at_least_32_characters
DAILY_EMAIL_PUBLIC_URL=https://codesniper.in
DAILY_EMAIL_ENABLED=false
DAILY_EMAIL_DRY_RUN=true
DAILY_EMAIL_TEST_RECIPIENT=
# Optional JSON object mapping published template keys to user fields:
# {"firstName":"name","unsubscribe_url":"unsubscribeUrl"}
RESEND_TEMPLATE_VARIABLE_MAP=
COMPILER_PROVIDER=local
# Optional: use a self-hosted Piston instance instead of local compilers
# COMPILER_PROVIDER=piston
# PISTON_API_URL=http://localhost:2000/api/v2/piston
